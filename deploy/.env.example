# Production settings for deploy/docker-compose.yml. Copy to deploy/.env on the
# server, fill in, `chmod 600 deploy/.env`. Never commit the filled-in copy.
#
# Every variable is described in docs/ops/07-production-secrets.md. Values
# shown are the ones specific to the VPS; the rest come from Render's
# Environment tab.
#
# An empty value is NOT the same as an unset one: `X=` gives Django the empty
# string, which breaks settings that expect a number or a class path
# (UNPAID_REGISTRATION_HOLD_HOURS, NOTIFICATIONS_PUSH_BACKEND, ...). Leave a
# line commented unless you have a value for it.

# --- Required ----------------------------------------------------------------
# Must be the SAME as on Render: it signs every login token and reset link.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.thefaithtribe.live,api-new.thefaithtribe.live
# The names Caddy serves (deploy/Caddyfile). Unset means api.thefaithtribe.live.
# During a rehearsal, only names whose DNS already points at this server.
# CADDY_HOSTS=api-new.thefaithtribe.live
# Origins allowed to POST forms to Django itself (the Django admin).
CSRF_TRUSTED_ORIGINS=https://api.thefaithtribe.live,https://api-new.thefaithtribe.live

# Postgres runs in the `db` container. Generate the password with
#   openssl rand -hex 24
# (hex, so it needs no escaping in the URL). Same value in both lines.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://faithtribe:CHANGE_ME@db:5432/faithtribe

# Redis runs in the `redis` container. Cache on db 0, Celery on db 1.
REDIS_URL=redis://redis:6379/0

# A worker exists now, so tasks go to the queue. Do NOT set
# CELERY_TASK_ALWAYS_EAGER or SCHEDULER_SECRET here (docs/ops/10).

PUBLIC_API_URL=https://api.thefaithtribe.live
FRONTEND_URL=https://www.thefaithtribe.live
# Shared event links on the main site (frontend/vercel.json passes /e/<slug> on).
EVENT_LINK_BASE=https://www.thefaithtribe.live/e
WEB_APP_URL=https://app.thefaithtribe.live
CORS_ALLOWED_ORIGINS=https://www.thefaithtribe.live,https://thefaithtribe.live,https://app.thefaithtribe.live
OTP_PROVIDER=users.otp_providers.EmailAndSmsOTPProvider

# Email over Brevo's HTTPS API (keep this one set; see docs/ops/07).
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=

# Cloudflare R2. Without these, uploads would go to the container's disk and
# vanish on the next deploy.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# --- Error reports (Sentry) -------------------------------------------------
# The DSN from sentry.io (Project Settings → Client Keys). Empty = off.
# SENTRY_RELEASE is set at build time (see the deploy steps), not here.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Copy from Render if set there -------------------------------------------
# R2_PRIVATE_BUCKET_NAME=
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
# TEST_EMAIL_RECIPIENT=
# PAY_LINK_BASE=
# ENFORCE_EMAIL_VERIFICATION=
# OTP_SMS_BACKEND=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SQUAD_SECRET_KEY=
# UNPAID_REGISTRATION_HOLD_HOURS=
# NOTIFICATIONS_PUSH_BACKEND=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=
# NOTIFICATIONS_DEVICE_PUSH_BACKEND=
# EXPO_ACCESS_TOKEN=
