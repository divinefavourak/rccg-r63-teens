# HTTPS in front of the API. Caddy fetches and renews the certificates itself
# (Let's Encrypt, HTTP-01 on port 80), so both names must point at this server
# before the first request, and ports 80 and 443 must be open.
#
# api-new is the rehearsal name used before the real one is moved over. Remove
# it here and in DNS once the cutover is settled (docs/ops/11 §After).
#
# Caddy sets X-Forwarded-Proto and X-Forwarded-For on the way in; Django reads
# the first through SECURE_PROXY_SSL_HEADER, DRF's throttles the second.

api.thefaithtribe.live, api-new.thefaithtribe.live {
	request_body {
		# Above Django's own limits (DATA_UPLOAD_MAX_MEMORY_SIZE, receipts at
		# 5 MB), so Django gives the error, not a bare 413 from here.
		max_size 25MB
	}

	reverse_proxy web:8000

	log {
		output stdout
		format console
	}
}
