# HTTPS in front of the API. Caddy fetches and renews the certificates itself
# (Let's Encrypt, HTTP-01 on port 80), so every name it serves must already
# point at this server, and ports 80 and 443 must be open.
#
# The names come from CADDY_HOSTS (deploy/docker-compose.yml, default
# api.thefaithtribe.live). During a rehearsal set it in deploy/.env to a name
# that already points here, e.g. CADDY_HOSTS=api-new.thefaithtribe.live: Caddy
# asks for a certificate for every name at start-up, and each one whose DNS
# still points elsewhere fails, counting against Let's Encrypt's limit of 5
# failed validations per name per hour, which can block the real one.
#
# Caddy sets X-Forwarded-Proto and X-Forwarded-For on the way in; Django reads
# the first through SECURE_PROXY_SSL_HEADER, DRF's throttles the second.

{$CADDY_HOSTS} {
	# Podcast episodes and videos are uploaded through the API (MediaUploader
	# in the console), and a 30-minute MP3 is already ~25 MB. The 25MB cap
	# below rejected those with a bare 413 that carries no CORS headers, so
	# the console could only say "The upload failed" (seen 18 November 2026
	# with a 24 MiB MP3 — Caddy's MB is 10^6 bytes, so 24 MiB is over 25MB).
	# Only these paths get the large limit; Django streams files above
	# FILE_UPLOAD_MAX_MEMORY_SIZE to a temp file, not RAM.
	@media_upload path /api/v1/media/* /api/media/*
	request_body @media_upload {
		max_size 500MB
	}

	@other_requests not path /api/v1/media/* /api/media/*
	request_body @other_requests {
		# Above Django's own limits (DATA_UPLOAD_MAX_MEMORY_SIZE, receipts at
		# 5 MB), so Django gives the error, not a bare 413 from here.
		max_size 25MB
	}

	reverse_proxy web:8000 {
		# While `web` is being recreated on a deploy (about 10 seconds) its
		# name does not resolve and nothing listens. Without this Caddy fails
		# those requests at once with a bare 502, which carries no CORS
		# headers, so the web app reports every call as a CORS error (seen
		# 18 November 2026). Caddy now holds a request and keeps trying for
		# up to 30 seconds. Only failures to connect are retried, so a
		# request is never sent to Django twice.
		lb_try_duration 30s
		lb_try_interval 500ms
	}

	log {
		output stdout
		format console
	}
}
