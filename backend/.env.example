# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database & Cache
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Used ONLY by `manage.py test` — never by runserver or migrate.
# Start the container first: docker compose -f docker-compose.test.yml up -d
# Leave blank to test against DATABASE_URL (very slow when that is remote).
TEST_DATABASE_URL=postgres://faithtribe:faithtribe@localhost:5433/faithtribe

# Timezone that defines a calendar day for daily content (today's devotional,
# Verse of the Day, reading-history day buckets). Storage stays UTC.
SCRIPTURE_TIMEZONE=Africa/Lagos

# Email (Brevo)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL=noreply@r63teens.com

# Payments (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000

# Testing
TEST_EMAIL_RECIPIENT=

# Cloudflare R2 Storage
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Get this from: Cloudflare Dashboard → account overview (top right)
R2_ACCOUNT_ID=
# The bucket name you created in R2
R2_BUCKET_NAME=rccg-r63-media
# Optional: custom public domain (e.g. pub-xxxx.r2.dev or media.yoursite.com)
# Leave blank to use the default internal R2 URL
R2_PUBLIC_DOMAIN=

