# Backend API URL
VITE_API_URL=http://localhost:8000/api

# Public Registration Agent Credentials
# These are used for public registrations when a user is not logged in
VITE_PUBLIC_AGENT_USERNAME=
VITE_PUBLIC_AGENT_PASSWORD=

# Where the landing page sends a teen for the app. Both have defaults in
# src/constants/site.ts; set these to change them without a code change.
# The Android address changes with every build.
VITE_ANDROID_APP_URL=
VITE_WEB_APP_URL=
